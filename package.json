{
  "name": "guya",
  "productName": "Guya",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal local voice-to-text utility (Gemini) for macOS and Windows",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node scripts/check-structure.js && node test/run.js",
    "check": "node scripts/check-structure.js",
    "icons": "node scripts/make-icons.js",
    "install:mac": "scripts/install.sh",
    "dist:mac": "electron-builder --mac --x64 && electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64 && electron-builder --win --arm64",
    "dist": "electron-builder --mac --x64 && electron-builder --mac --arm64 && electron-builder --win --x64 && electron-builder --win --arm64 && electron-builder --linux --x64 && electron-builder --linux --arm64",
    "e2e": "node test/e2e.js",
    "dist:linux": "electron-builder --linux --x64 && electron-builder --linux --arm64",
    "dist:this": "node scripts/dist-this.js",
    "notes": "node scripts/notes.js"
  },
  "build": {
    "appId": "com.local.guya",
    "productName": "Guya",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "artifactName": "Guya-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Guya needs the microphone to record your voice for transcription."
      }
    },
    "win": {
      "icon": "build/icon-shape.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Guya-${version}-Windows-${arch}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "synopsis": "Minimal voice-to-text with your own Gemini key",
      "description": "A minimal voice-to-text utility: one shortcut records, the audio goes to the Gemini API with your own key, and the transcript lands on the clipboard.",
      "maintainer": "Mahdi Mirshafiee <Mirshafieemahdi001@gmail.com>",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ],
      "artifactName": "Guya-${version}-Linux-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Guya-${version}-Windows-${arch}-Portable.${ext}"
    },
    "appImage": {
      "artifactName": "Guya-${version}-Linux-${arch}.${ext}"
    },
    "electronLanguages": [
      "en-US",
      "fa"
    ]
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "@noble/hashes": "^1.8.0"
  },
  "author": "Mahdi Mirshafiee",
  "license": "MIT",
  "homepage": "https://github.com/MahdiMirshafiee/guya",
  "desktopName": "guya.desktop"
}
